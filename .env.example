# ============================================================
# Webhook Event Ingestion Service — Environment Variables
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit .env to version control.
# On DigitalOcean App Platform, set these in the dashboard
# or let DO inject them automatically (e.g. DATABASE_URL).
# ============================================================

# Server
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/webhook_db

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
